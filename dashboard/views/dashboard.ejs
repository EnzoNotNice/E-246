<%- include('partials/header') %>
<%
guilds = typeof guilds !== 'undefined' && Array.isArray(guilds) ? guilds : [];
botGuilds = typeof botGuilds !== 'undefined' && botGuilds ? botGuilds : new Set();
stats = typeof stats !== 'undefined' && stats ? stats : { totalGuilds: 0, uptime: '0s', ping: '0ms' };
user = typeof user !== 'undefined' ? user : null;
%>
<%- include('partials/sidebar', { activeTab: 'servers' }) %>

<main class="app-content">

    <!-- Page Header -->
    <div class="content-header">
        <h1><i class="fa-solid fa-server"></i> لوحة التحكم</h1>
        <p>إدارة سريعة ومتكاملة لجميع سيرفراتك وإعدادات البوت في مكان واحد</p>
    </div>

    <!-- Stats Overview -->
    <div class="bento-grid cols-4" style="margin-bottom: 24px;">

        <div class="glass-panel reveal metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-server"></i>
            </div>
            <div class="metric-value" data-count="<%= guilds.length %>"><%= guilds.length %></div>
            <div class="metric-label">سيرفراتك المتاحة</div>
        </div>

        <div class="glass-panel reveal metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-globe"></i>
            </div>
            <div class="metric-value" data-count="<%= typeof stats !== 'undefined' ? stats.totalGuilds : botGuilds.size %>"><%= typeof stats !== 'undefined' ? stats.totalGuilds : botGuilds.size %></div>
            <div class="metric-label">سيرفرات البوت الكلية</div>
        </div>

        <div class="glass-panel reveal metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-clock-rotate-left"></i>
            </div>
            <div class="metric-value uptime-display" style="font-size: 1.25rem; line-height: 1.2; direction: ltr;">
                <%= typeof stats !== 'undefined' ? stats.uptime : '—' %>
            </div>
            <div class="metric-label">مدة التشغيل</div>
        </div>

        <div class="glass-panel reveal metric-card">
            <div class="metric-icon">
                <i class="fa-solid fa-signal"></i>
            </div>
            <div class="metric-value" style="font-size: 1.35rem; direction: ltr;">
                <%= typeof stats !== 'undefined' ? stats.ping : '—' %>
            </div>
            <div class="metric-label">زمن الاستجابة (Ping)</div>
        </div>

    </div>

    <% if (guilds.length > 0) { %>
    <!-- Guilds Filter & Search Controls -->
    <div class="guild-controls-bar reveal">
        <div class="guild-search-wrap">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="guildSearchInput" class="guild-search-input" placeholder="ابحث باسم السيرفر..." autocomplete="off">
        </div>

        <div class="filter-pills-wrap">
            <button type="button" class="filter-pill active" data-filter="all">الكل</button>
            <button type="button" class="filter-pill" data-filter="active">مفعّل</button>
            <button type="button" class="filter-pill" data-filter="inactive">غير مضاف</button>
        </div>

        <div class="guild-count-badge">
            عرض <span id="visibleGuildsCount"><%= guilds.length %></span> من <%= guilds.length %> سيرفر
        </div>
    </div>

    <!-- Guilds Grid -->
    <div class="guild-grid reveal" id="guildGrid">
        <% guilds.forEach(guild => { %>
            <% const isBotInGuild = botGuilds.has(guild.id); %>
            <div class="guild-card" data-name="<%= (guild.name || '').toLowerCase() %>" data-status="<%= isBotInGuild ? 'active' : 'inactive' %>">
                
                <span class="guild-card-badge <%= isBotInGuild ? 'active' : 'inactive' %>">
                    <% if (isBotInGuild) { %>
                        <i class="fa-solid fa-circle-check"></i> مفعّل
                    <% } else { %>
                        <i class="fa-solid fa-plus"></i> غير مضاف
                    <% } %>
                </span>

                <div class="guild-icon-wrap">
                    <% if (guild.icon) { %>
                        <img
                            src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128"
                            alt="<%= guild.name %>"
                            loading="lazy"
                            class="guild-icon-img"
                            onerror="this.onerror=null;this.src='/img/logo.png';"
                        >
                    <% } else { %>
                        <div class="guild-icon-fallback"><%= (guild.name || 'S').charAt(0).toUpperCase() %></div>
                    <% } %>
                </div>

                <h3 class="guild-title" title="<%= guild.name %>"><%= guild.name %></h3>

                <div class="guild-card-footer">
                    <% if (isBotInGuild) { %>
                        <a href="/dashboard/<%= guild.id %>" class="btn btn-primary btn-block">
                            <i class="fa-solid fa-sliders"></i> لوحة التحكم
                        </a>
                    <% } else { %>
                        <a href="https://discord.com/api/oauth2/authorize?client_id=<%= process.env.CLIENT_ID %>&permissions=8&scope=bot%20applications.commands&guild_id=<%= guild.id %>&disable_guild_select=true" class="btn btn-secondary btn-block">
                            <i class="fa-solid fa-plus"></i> إضافة البوت
                        </a>
                    <% } %>
                </div>

            </div>
        <% }) %>
    </div>

    <!-- No Search Results Found Placeholder -->
    <div id="noSearchResults" class="glass-panel text-center" style="display: none; padding: 48px 20px; margin-top: 16px;">
        <i class="fa-solid fa-magnifying-glass" style="font-size: 2.2rem; color: var(--text-3); margin-bottom: 12px; display: inline-block;"></i>
        <h3 style="font-size: 1.1rem; color: var(--text-1); margin-bottom: 6px;">لا توجد سيرفرات مطابقة</h3>
        <p style="color: var(--text-2); font-size: 0.85rem;">لم يتم العثور على أي سيرفر يطابق معايير البحث أو الفلتر المحددة</p>
    </div>

    <% } else { %>
    <!-- Empty State -->
    <div class="glass-panel reveal empty-state">
        <div class="empty-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <h2>لا يوجد سيرفرات متاحة</h2>
        <p>ليس لديك صلاحيات إدارية (Manage Server أو Administrator) في أي سيرفر حتى الآن</p>
    </div>
    <% } %>

</main>

<style>
.empty-state {
    text-align: center;
    padding: 64px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}
.empty-state .empty-icon {
    font-size: 3rem;
    color: var(--text-3);
    margin-bottom: 16px;
    line-height: 1;
}
.empty-state h2 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-1);
    margin-bottom: 8px;
}
.empty-state p {
    color: var(--text-2);
    font-size: 0.85rem;
    max-width: 360px;
    margin: 0 auto;
    line-height: 1.5;
}
</style>

<%- include('partials/footer') %>
