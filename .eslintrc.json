{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "warn",
    "no-undef": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "error",
    "require-await": "warn"
  },
  "overrides": [
    {
      "files": ["dashboard/public/**/*.js"],
      "env": {
        "browser": true
      },
      "rules": {
        "no-undef": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "assets/"],
  "plugins": ["prettier"]
}
